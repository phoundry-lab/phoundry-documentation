---
import { Aside } from "@astrojs/starlight/components";
import MarkdownContent from "@astrojs/starlight/components/MarkdownContent.astro";
import Overlays from "./docs/Overlays.svelte";
const route = Astro.locals.starlightRoute;
const { ai_disclosure, status } = route.entry.data;
const ui = route.id.startsWith("phoundry-ui");
---

{status === "experimental" && (
	<aside class="docs-notice">
		Experimental: this API may change as it is developed.
	</aside>
)}
{ui && <Overlays client:load />}
{ai_disclosure === true && (
	<div data-pagefind-ignore>
		<Aside title="AI Disclosure">
			This page was generated by an LLM and may contain inaccuracies.
			Hand-crafted documentation will be implemented over time on the road to
			1.0.
		</Aside>
	</div>
)}
<MarkdownContent>
	<slot />
</MarkdownContent>
<footer class="docs-article-footer">
	<p>
		Documentation is licensed under{" "}
		<a href="https://creativecommons.org/licenses/by/4.0/">CC BY 4.0</a>.
		Phoundry names and marks remain reserved.
	</p>
</footer>
