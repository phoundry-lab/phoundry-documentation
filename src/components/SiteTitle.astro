---
const { siteTitleHref } = Astro.locals.starlightRoute;
---

<a
	href={siteTitleHref}
	class="phials-brand"
	aria-label="Phials documentation home"
>
	<img src="/icons/phials-icon-32.svg" width="32" height="32" alt="" />
	<span translate="no">PHIALS</span>
</a>

<style>
	@font-face {
		font-family: "Orbitron";
		src: url("/fonts/orbitron-variable.ttf") format("truetype");
		font-style: normal;
		font-weight: 400 900;
		font-display: swap;
	}

	.phials-brand {
		display: inline-flex;
		align-items: center;
		gap: 0.65rem;
		min-width: 0;
		color: var(--sl-color-text-accent);
		font-family: "Orbitron", sans-serif;
		font-size: 1.25rem;
		font-weight: 600;
		letter-spacing: 0.06em;
		line-height: 1;
		text-decoration: none;
		white-space: nowrap;
	}

	img {
		flex-shrink: 0;
	}
</style>
