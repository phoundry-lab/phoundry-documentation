{
	"name": "@phoundry/documentation",
	"version": "1.0.0",
	"description": "Canonical Phoundry documentation, static site, and Phials offline Help artifact",
	"private": true,
	"type": "module",
	"license": "MIT",
	"engines": {
		"node": "24.x"
	},
	"scripts": {
		"dev": "npm run generate && astro dev --host 127.0.0.1 --port 5179",
		"generate": "npm run generate:sdk-reference && tsx scripts/generate-documentation.ts && node scripts/generate-ui-api.mjs",
		"build:site": "node scripts/build-site.mjs",
		"build:package": "npm run generate && tsx scripts/build-package.ts && tsx scripts/verify-package.ts",
		"generate:sdk-reference": "node scripts/sdk-reference/generate-type-references.mjs && node scripts/sdk-reference/link-type-references.mjs",
		"build": "npm run build:site && npm run build:package",
		"preview": "astro preview --host 127.0.0.1 --port 4179",
		"check": "npm run generate && astro check && svelte-check --tsconfig ./tsconfig.svelte.json",
		"test": "npm run generate && vitest run",
		"validate": "npm run check && npm run test && npm run build",
		"release:documentation": "node scripts/publish-documentation.mjs",
		"format": "prettier --write .",
		"format:check": "prettier --check ."
	},
	"dependencies": {
		"@iconify/svelte": "^5.2.1",
		"phoundry-ui": "0.4.24"
	},
	"devDependencies": {
		"@astrojs/check": "0.9.12",
		"@astrojs/markdown-remark": "7.3.0",
		"@astrojs/sitemap": "3.7.4",
		"@astrojs/starlight": "0.42.10",
		"@astrojs/svelte": "9.1.5",
		"@phoundry/phials-plugin-sdk": "3.1.0",
		"@tailwindcss/vite": "^4.2.2",
		"@types/mdast": "^4.0.4",
		"@types/node": "^24",
		"astro": "7.4.11",
		"fast-glob": "^3.3.3",
		"github-slugger": "2.0.0",
		"gray-matter": "^4.0.3",
		"pagefind": "^1.4.0",
		"parse5": "8.1.1",
		"prettier": "^3.8.1",
		"prettier-plugin-astro": "1.1.2",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"shiki": "^4.0.2",
		"starlight-sidebar-topics": "0.9.0",
		"svelte": "5.56.8",
		"svelte-check": "^4.4.6",
		"svelte-docinfo": "0.18.0",
		"svelte2tsx": "0.7.63",
		"tailwindcss": "^4.2.2",
		"tsx": "^4.21.0",
		"typescript": "^6.0.3",
		"unist-util-visit": "^5.1.0",
		"vite": "^8.0.16",
		"vitest": "^4.1.4"
	},
	"allowScripts": {
		"esbuild@0.28.1": true
	}
}
