{
	"name": "@phoundry/documentation",
	"version": "1.0.0",
	"description": "Canonical Phoundry documentation, static site, and Phials offline Help artifact",
	"type": "module",
	"license": "MIT",
	"engines": {
		"node": "24.x"
	},
	"files": [
		"dist-package",
		"README.md",
		"LICENSE"
	],
	"exports": {
		".": {
			"types": "./dist-package/index.d.ts",
			"import": "./dist-package/index.js"
		}
	},
	"scripts": {
		"dev": "npm run generate && vite dev --host 127.0.0.1 --port 5179 --strictPort",
		"generate": "tsx scripts/generate-documentation.ts",
		"build:site": "npm run generate && svelte-kit sync && vite build && pagefind --site build",
		"build:package": "npm run generate && tsx scripts/build-package.ts",
		"generate:sdk-reference": "node scripts/sdk-reference/generate-type-references.mjs && node scripts/sdk-reference/link-type-references.mjs",
		"build": "npm run build:site && npm run build:package",
		"preview": "vite preview --host 127.0.0.1 --port 4179 --strictPort",
		"prepare": "npm run generate && svelte-kit sync || echo ''",
		"check": "npm run generate && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test": "npm run generate && vitest run",
		"validate": "npm run check && npm run test && npm run build",
		"release:documentation": "node scripts/publish-documentation.mjs",
		"format": "prettier --write .",
		"format:check": "prettier --check ."
	},
	"dependencies": {
		"@iconify/svelte": "^5.2.1",
		"phoundry-ui": "git+https://github.com/phoundry-lab/phoundry-ui.git#0b3fa2c"
	},
	"devDependencies": {
		"@shikijs/rehype": "^4.0.2",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.67.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.2.2",
		"@types/mdast": "^4.0.4",
		"@types/node": "^24",
		"fast-glob": "^3.3.3",
		"gray-matter": "^4.0.3",
		"hast-util-to-html": "^9.0.5",
		"mdsvex": "^0.12.7",
		"pagefind": "^1.4.0",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"rehype-autolink-headings": "^7.1.0",
		"rehype-slug": "^6.0.0",
		"shiki": "^4.0.2",
		"svelte": "^5.55.2",
		"svelte-check": "^4.4.6",
		"tailwindcss": "^4.2.2",
		"tsx": "^4.21.0",
		"typescript": "^6.0.3",
		"unist-util-visit": "^5.1.0",
		"vite": "^8.0.16",
		"vitest": "^4.1.4"
	},
	"publishConfig": {
		"access": "public"
	},
	"allowScripts": {
		"github:phoundry-lab/phoundry-ui#0b3fa2c": true,
		"esbuild@0.28.1": true
	}
}
